<Window x:Class="IslandDock.Tutorial"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Island" Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="True" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseDown" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="TourButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="Background" Value="#18FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="24" Background="#F21A1A1D" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="20" Padding="32,30,32,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel>
            <Grid x:Name="Page" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="PageShift"/>
                </Grid.RenderTransform>
                <StackPanel>
                    <Border Width="64" Height="64" CornerRadius="32" Background="#264CC2FF" HorizontalAlignment="Left">
                        <TextBlock x:Name="Glyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                                   Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="Heading" Margin="0,20,0,0" FontSize="22" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                    <StackPanel x:Name="Points" Margin="0,12,0,0" MinHeight="128"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,22,0,0">
                <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SkipButton" Content="Skip" Style="{StaticResource TourButton}" Background="Transparent"
                            Foreground="#99FFFFFF" Click="Skip_Click"/>
                    <Button x:Name="BackButton" Content="Back" Style="{StaticResource TourButton}" Margin="6,0,0,0" Click="Back_Click"/>
                    <Button x:Name="NextButton" Content="Next" Style="{StaticResource TourButton}" Margin="6,0,0,0"
                            Background="#4CC2FF" Foreground="#FF0B1A24" FontWeight="SemiBold" Click="Next_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
