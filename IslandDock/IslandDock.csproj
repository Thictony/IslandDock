<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK TFM gives access to WinRT radio and power APIs used by the quick settings bar. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>IslandDock</AssemblyName>
    <RootNamespace>IslandDock</RootNamespace>
    <Version>1.0.7</Version>
    <StartupObject>IslandDock.Program</StartupObject>
    <!-- DPI awareness is declared in app.manifest because this is a WPF app, not a WinForms one. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

</Project>
